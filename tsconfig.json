{
  "extends": "./extension/tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "node",
    "target": "ES2020",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "outDir": "./",
    "rootDir": ".",
    "types": ["@types/node", "@vercel/node"]
  },
  "include": [
    "api/**/*.ts",
    "public/**/*",
    // ...any other source dirs
  ]
}
