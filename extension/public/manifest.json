{
  "manifest_version": 3,
  "name": "FloatPilot",
  "version": "0.3.0",
  "description": "Analyze CS2 skin floats and market data in real-time to find profitable flips.",

  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "https://api.exchangerate.host/*",
    "https://floatpilot.store/"
  ],

  "host_permissions": [
    "https://csfloat.com/*",
    "https://skinport.com/*",
    "https://api.exchangerate.host/*",
    "https://floatpilot.store/"
  ],

  "background": {
    "service_worker": "src/background/sw.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://skinport.com/*"],
      "js": ["src/content-scripts/skinportContent.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://csfloat.com/*"],
      "js": ["src/content-scripts/listingEstimation.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://csfloat.com/item/*"],
      "js": ["src/content-scripts/itemContent.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://csfloat.com/*"],
      "js": ["src/content-scripts/priceDiff.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://csfloat.com/search*"],
      "js": ["src/content-scripts/injectStyle.js", "src/content-scripts/searchFilter.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://csfloat.com/*", "https://skinport.com/*", "https://steamcommunity.com/*"],
      "js": ["src/content-scripts/listingFetcher.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon16.png",
        "icons/icon48.png",
        "icons/icon128.png"
      ],
      "matches": ["<all_urls>"]
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
