{
  "manifest_version": 3,
  "name": "FloatPilot",
  "version": "0.1.0",
  "description": "Analyze CS2 skins and market data to find profitable flips faster than ever before.",

  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab"
  ],

  "host_permissions": [
    "https://csfloat.com/*",
    "https://www.floatpilot.store/"
  ],

  "background": {
    "service_worker": "src/background/sw.js",
    "type": "module"
  },

  "content_scripts": [

    {
      "matches": ["*://csfloat.com/*"],
      "js": ["inject-loader.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://csfloat.com/*"],
      "js": ["src/content-scripts/profitEvaluator.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://csfloat.com/profile/offers"],
      "js": ["src/content-scripts/bargainHelper.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://csfloat.com/*"],
      "js": ["src/content-scripts/refreshButton.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://csfloat.com/*"],
      "js": ["src/content-scripts/floatHighlighter.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://csfloat.com/*"],
      "js": ["src/content-scripts/listingEstimation.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://csfloat.com/*"],
      "js": ["src/content-scripts/priceDiff.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://csfloat.com/search*"],
      "js": [
        "src/content-scripts/injectStyle.js",
        "src/content-scripts/searchFilter.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon16.png",
        "icons/icon48.png",
        "icons/icon128.png",
        "offscreen/offscreen.html",
        "injected/fetch-intercept.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
