{
  "manifest_version": 3,
  "name": "FloatPilot",
  "version": "0.1.0",
  "description": "Analyze CS2 skin floats and market data in real-time to find profitable flips.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://csfloat.com/*"],
      "js": ["content-scripts/grabListings.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.csgofloat.com/*",
    "https://csfloat.com/*"
  ]
}
